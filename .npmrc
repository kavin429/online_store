# Only fetch native/optional binaries for the machine doing the install.
# Without this, pnpm downloads SWC/Turbo binaries for every OS and CPU
# (~700 MB in this repo).
supportedArchitectures[os]=current
supportedArchitectures[cpu]=current
supportedArchitectures[libc]=current

# Keep the workspace dependency set reproducible.
auto-install-peers=true
strict-peer-dependencies=false
