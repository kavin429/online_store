// ═══════════════════════════════════════════════════════════════
// THIS IS THE ONLY SCHEMA IN THE MONOREPO.
// Every app (store / vendor / admin) talks to this one database
// through @online-store/db. Never copy this file into an app.
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ── Admin ──
// ═══════════════════════════════════════════════════════════════

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  promos Promo[]
}

// ═══════════════════════════════════════════════════════════════
// ── Countries ──
// ═══════════════════════════════════════════════════════════════

// Master list of countries the platform ships to. Managed from the admin
// panel; used to populate the country dropdowns and to drive shipping.
model Country {
  id Int @id @default(autoincrement())

  name      String  @unique
  code      String  @unique // ISO-3166 alpha-2, e.g. "LK"
  currency  String? // ISO-4217, e.g. "LKR"
  phoneCode String? // e.g. "+94"
  flag      String?

  status CountryStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CountryStatus {
  ACTIVE
  INACTIVE
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor ──
// ═══════════════════════════════════════════════════════════════

model Vendor {
  id Int @id @default(autoincrement())

  name  String
  image String?

  email String @unique
  phone String

  country  String?
  province String?
  district String?
  city     String?
  address  String?

  password      String
  plainPassword String?

  status            VendorStatus @default(PENDING)
  blockReason       String?
  blockedAt         DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  isProfileComplete Boolean      @default(false)

  products       Product[]
  vendorSettings VendorSettings?
  payouts        Payout[]
  notifications  Notification[]
  promos         Promo[]
  offers         Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VendorStatus {
  ACTIVE
  BLOCKED
  PENDING
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// ── Categories ──
// ═══════════════════════════════════════════════════════════════

model Category {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  status    CategoryStatus @default(PENDING)
  image     Bytes?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  subcategories SubCategory[]
  products      Product[]
}

enum CategoryStatus {
  ACTIVE
  PENDING
}

model SubCategory {
  id          Int               @id @default(autoincrement())
  name        String
  status      SubCategoryStatus @default(PENDING)
  description String?
  commission  Float?
  image       Bytes?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]

  variantTypes SubCategoryVariantType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubCategoryStatus {
  ACTIVE
  PENDING
}

model SubCategoryVariantType {
  id            Int         @id @default(autoincrement())
  subcategoryId Int
  subcategory   SubCategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  variantTypeId Int
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, variantTypeId])
}

// ═══════════════════════════════════════════════════════════════
// ── Products ──
// ═══════════════════════════════════════════════════════════════

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  costPrice       Float?
  sellingPrice    Float?
  discountPercent Float?
  stock           Int    @default(0)

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  featured Boolean       @default(false)
  status   ProductStatus @default(PENDING)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subcategoryId Int?
  subcategory   SubCategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]

  offerProducts OfferProduct[]

  createdAt DateTime @default(now())
}

enum ProductStatus {
  ACTIVE
  PENDING
}

model ProductImage {
  id   Int   @id @default(autoincrement())
  data Bytes

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id Int @id @default(autoincrement())

  sku           String? @unique
  priceOverride Float?
  stock         Int     @default(0)
  image         Bytes?

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  values ProductVariantValue[]

  inventoryLogs InventoryLog[]

  createdAt DateTime @default(now())
}

model ProductVariantValue {
  id Int @id @default(autoincrement())

  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  variantValueId Int
  variantValue   VariantValue @relation(fields: [variantValueId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, variantValueId])
}

// ═══════════════════════════════════════════════════════════════
// ── Variant Types / Values ──
// ═══════════════════════════════════════════════════════════════

model VariantType {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  values        VariantValue[]
  subcategories SubCategoryVariantType[]
}

model VariantValue {
  id            Int         @id @default(autoincrement())
  variantTypeId Int
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)

  name      String
  hexCode   String?
  unit      String?
  status    VariantStatus @default(active)
  sortOrder Int           @default(0)

  productVariants ProductVariantValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VariantStatus {
  active
  inactive
}

// ═══════════════════════════════════════════════════════════════
// ── Users / Customers ──
// ═══════════════════════════════════════════════════════════════

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

model User {
  id Int @id @default(autoincrement())

  name  String? @unique
  image String?

  email String? @unique
  phone String?

  country  String?
  province String?
  district String?
  city     String?
  address  String?

  password String?

  emailVerified DateTime?
  phoneVerified Boolean   @default(false)

  provider   String?
  providerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  orders   Order[]
  reviews  Review[]

  status      CustomerStatus @default(ACTIVE)
  blockReason String?
  blockedAt   DateTime?

  // ── Promos ──
  targetedPromos PromoCustomer[]
  promoUsages    PromoUsage[]
  notifications  CustomerNotification[]

  // ── Push ──
  pushSubscriptions PushSubscription[]

  // ── Offers ──
  claimedOffers OfferClaim[]
}

model Account {
  id                String @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════════
// ── Orders ──
// ═══════════════════════════════════════════════════════════════

model Order {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  fullName      String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String
  paymentMethod String // "cod" | "card"

  subtotal Float
  shipping Float

  // ── Promo code applied to this order (denormalized for quick display) ──
  promoCode      String?
  discountAmount Float   @default(0)

  total Float // = subtotal + shipping - discountAmount

  status OrderStatus @default(PENDING)
  items  OrderItem[]

  returnRequest ReturnRequest?
  payoutItems   PayoutItem[]
  promoUsage    PromoUsage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId        Int
  productVariantId Int?

  name         String
  sellingPrice Float
  quantity     Int
}

// ═══════════════════════════════════════════════════════════════
// ── Reviews ──
// ═══════════════════════════════════════════════════════════════

model Review {
  id Int @id @default(autoincrement())

  rating  Int
  comment String?

  userId Int
  user   User @relation(fields: [userId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  responses ReviewResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReviewResponse {
  id      Int    @id @default(autoincrement())
  comment String

  reviewId Int
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor Store Settings ──
// ═══════════════════════════════════════════════════════════════

model VendorSettings {
  id Int @id @default(autoincrement())

  vendorId Int    @unique
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  storeName   String?
  storeLogo   String?
  storeBanner String?
  description String?

  taxId       String?
  businessReg String?

  bankName      String?
  accountName   String?
  accountNumber String?
  branch        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor Payouts ──
// ═══════════════════════════════════════════════════════════════

model Payout {
  id Int @id @default(autoincrement())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount Float
  status PayoutStatus @default(PENDING)
  period String
  paidAt DateTime?
  note   String?

  items PayoutItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

model PayoutItem {
  id       Int    @id @default(autoincrement())
  payoutId Int
  payout   Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  amount Float
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor Notifications ──
// ═══════════════════════════════════════════════════════════════

model Notification {
  id Int @id @default(autoincrement())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  type    String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ── Promos ──
// ═══════════════════════════════════════════════════════════════

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

// Who the promo is aimed at:
// ALL              -> anyone can use it
// NEW_CUSTOMER     -> customers with zero prior orders (first purchase only)
// OLD_CUSTOMER     -> customers who already have at least one order
// SELECTED_CUSTOMER-> a criteria-matched list (see PromoCustomer)
enum PromoTargetType {
  ALL
  NEW_CUSTOMER
  OLD_CUSTOMER
  SELECTED_CUSTOMER
}

enum PromoStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Promo {
  id Int @id @default(autoincrement())

  code        String  @unique
  name        String  @default("")
  description String?

  discountType   PromoDiscountType
  discountValue  Float
  maxDiscount    Float? // cap on discount amount when discountType = PERCENTAGE
  minOrderAmount Float?

  targetType PromoTargetType @default(ALL)

  // ── Criteria used ONLY when targetType = SELECTED_CUSTOMER ──
  minOrderCount Int?
  minTotalSpent Float?
  maxTotalSpent Float?

  // ── Usage limits ──
  usageLimit        Int? // overall redemption cap across all customers (null = unlimited)
  usageLimitPerUser Int  @default(1)
  usedCount         Int  @default(0)

  expiresAt DateTime?
  startsAt  DateTime?

  status PromoStatus @default(ACTIVE)

  // ── Who created it ──
  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  adminId Int?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  targetCustomers PromoCustomer[]
  usages          PromoUsage[]
  notifications   CustomerNotification[]
  offers          Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per customer targeted by a promo.
// Also doubles as the notification-sent tracker.
model PromoCustomer {
  id Int @id @default(autoincrement())

  promoId Int
  promo   Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notified   Boolean   @default(false)
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([promoId, userId])
}

// One row per actual redemption — ties a promo to the order it was used on.
model PromoUsage {
  id Int @id @default(autoincrement())

  promoId Int
  promo   Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountAmount Float

  createdAt DateTime @default(now())
}

// ── Customer-facing notifications ──
model CustomerNotification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // e.g. "PROMO_CODE", "ORDER_UPDATE"
  title   String
  message String
  read    Boolean @default(false)

  promoId Int?
  promo   Promo? @relation(fields: [promoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ── Return Requests ──
// ═══════════════════════════════════════════════════════════════

model ReturnRequest {
  id Int @id @default(autoincrement())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reason       String
  status       ReturnStatus @default(PENDING)
  adminNote    String?
  refundAmount Float?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

// ═══════════════════════════════════════════════════════════════
// ── Shipping ──
// ═══════════════════════════════════════════════════════════════

model ShippingZone {
  id Int @id @default(autoincrement())

  name    String
  regions String

  rates ShippingRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingRate {
  id Int @id @default(autoincrement())

  zoneId Int
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  minWeight Float?
  maxWeight Float?
  price     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// ── Inventory ──
// ═══════════════════════════════════════════════════════════════

model InventoryLog {
  id Int @id @default(autoincrement())

  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  change Int
  reason String
  note   String?

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ── Push Notifications ──
// ═══════════════════════════════════════════════════════════════

model PushSubscription {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
}

model AdminPushSubscription {
  id Int @id @default(autoincrement())

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ── Offers (landing-page deals / banners) ──
// ═══════════════════════════════════════════════════════════════

enum OfferStatus {
  ACTIVE
  INACTIVE
}

// Whether an offer is allowed to appear on the storefront.
// Admin-created offers are APPROVED straight away; vendor-created offers
// start as PENDING and only go live once an admin approves them.
enum OfferApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// A landing-page deal/banner. Display-only: it can point at products and
// (optionally) show a Promo code, but it does not change prices by itself.
model Offer {
  id Int @id @default(autoincrement())

  title       String
  subtitle    String?
  description String? @db.Text
  image       String? @db.LongText // base64 data URL or image URL
  images      String? @db.LongText // JSON array of gallery image data URLs

  badgeText String? // e.g. "20% OFF", "Festival Sale"
  ctaText   String  @default("Shop Now")
  ctaLink   String? // where the button goes, e.g. /products?category=3

  // optional: show this promo code on the offer card
  promoId Int?
  promo   Promo? @relation(fields: [promoId], references: [id], onDelete: SetNull)

  // The vendor that submitted the offer. Null for offers created by an admin.
  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  approvalStatus OfferApprovalStatus @default(APPROVED)
  reviewNote     String?

  products OfferProduct[]
  claims   OfferClaim[]

  sortOrder     Int     @default(0) // lower = shown first
  showOnLanding Boolean @default(true) // false = only on the /offer page

  startsAt DateTime?
  endsAt   DateTime?

  status OfferStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfferProduct {
  id Int @id @default(autoincrement())

  offerId Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
}

// A customer claiming an offer (deals/banner). One claim per customer
// per offer — the unique index makes the claim endpoint idempotent.
model OfferClaim {
  id Int @id @default(autoincrement())

  offerId Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, userId])
}
