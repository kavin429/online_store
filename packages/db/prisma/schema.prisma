// ═══════════════════════════════════════════════════════════════
// THIS IS THE ONLY SCHEMA IN THE MONOREPO.
// Every app (store / vendor / admin) talks to this one database
// through @online-store/db. Never copy this file into an app.
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ── Admin ──
// ═══════════════════════════════════════════════════════════════

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())

  promos          Promo[]
  reviewResponses ReviewResponse[] @relation("ReviewResponseAuthor")
}

// ═══════════════════════════════════════════════════════════════
// ── Countries ──
// ═══════════════════════════════════════════════════════════════

// Master list of countries the platform ships to. Managed from the admin
// panel; used to populate the country dropdowns and to drive shipping.
model Country {
  id Int @id @default(autoincrement())

  name      String  @unique
  code      String  @unique // ISO-3166 alpha-2, e.g. "LK"
  currency  String? // ISO-4217, e.g. "LKR"
  phoneCode String? // e.g. "+94"
  flag      String?

  status CountryStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CountryStatus {
  ACTIVE
  INACTIVE
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor ──
// ═══════════════════════════════════════════════════════════════

model Vendor {
  id Int @id @default(autoincrement())

  name  String
  image String?

  email String @unique
  phone String

  country  String?
  province String?
  district String?
  city     String?
  address  String?

  password      String
  plainPassword String?

  status            VendorStatus @default(PENDING)
  blockReason       String?
  blockedAt         DateTime?
  cancelReason      String?
  cancelledAt       DateTime?
  isProfileComplete Boolean      @default(false)

  products       Product[]
  vendorSettings VendorSettings?
  payouts        Payout[]
  notifications  Notification[]
  promos         Promo[]
  offers         Offer[]
  variantValues  VariantValue[]

  // ── Reviews ──
  reportedReviews Review[]         @relation("ReviewReports")
  reviewResponses ReviewResponse[] @relation("ReviewResponseAuthor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VendorStatus {
  ACTIVE
  BLOCKED
  PENDING
  CANCELLED
}

// ═══════════════════════════════════════════════════════════════
// ── Categories ──
// ═══════════════════════════════════════════════════════════════

model Category {
  id        Int            @id @default(autoincrement())
  name      String         @unique
  status    CategoryStatus @default(PENDING)
  image     Bytes?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  subcategories SubCategory[]
  products      Product[]
}

enum CategoryStatus {
  ACTIVE
  PENDING
}

model SubCategory {
  id          Int               @id @default(autoincrement())
  name        String
  status      SubCategoryStatus @default(PENDING)
  description String?
  commission  Float?
  image       Bytes?

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  products Product[]
  offers   Offer[]

  variantTypes SubCategoryVariantType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubCategoryStatus {
  ACTIVE
  PENDING
}

model SubCategoryVariantType {
  id            Int         @id @default(autoincrement())
  subcategoryId Int
  subcategory   SubCategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  variantTypeId Int
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, variantTypeId])
}

// ═══════════════════════════════════════════════════════════════
// ── Products ──
// ═══════════════════════════════════════════════════════════════

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  costPrice       Float?
  sellingPrice    Float?
  discountPercent Float?
  stock           Int    @default(0)

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  featured Boolean       @default(false)
  status   ProductStatus @default(PENDING)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  subcategoryId Int?
  subcategory   SubCategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  images   ProductImage[]
  variants ProductVariant[]
  reviews  Review[]

  offerProducts OfferProduct[]

  createdAt DateTime @default(now())
}

enum ProductStatus {
  ACTIVE
  PENDING
}

model ProductImage {
  id   Int   @id @default(autoincrement())
  data Bytes

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id Int @id @default(autoincrement())

  sku           String? @unique
  priceOverride Float?
  stock         Int     @default(0)
  image         Bytes?

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  values ProductVariantValue[]

  inventoryLogs InventoryLog[]
  batches       InventoryBatch[]

  createdAt DateTime @default(now())
}

model ProductVariantValue {
  id Int @id @default(autoincrement())

  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  variantValueId Int
  variantValue   VariantValue @relation(fields: [variantValueId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, variantValueId])
}

// ═══════════════════════════════════════════════════════════════
// ── Variant Types / Values ──
// ═══════════════════════════════════════════════════════════════

model VariantType {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  values        VariantValue[]
  subcategories SubCategoryVariantType[]
}

model VariantValue {
  id            Int         @id @default(autoincrement())
  variantTypeId Int
  variantType   VariantType @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)

  name      String
  hexCode   String?
  unit      String?
  status    VariantStatus @default(active)
  sortOrder Int           @default(0)

  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  productVariants ProductVariantValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VariantStatus {
  active
  inactive
}

// ═══════════════════════════════════════════════════════════════
// ── Users / Customers ──
// ═══════════════════════════════════════════════════════════════

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

model User {
  id Int @id @default(autoincrement())

  name  String? @unique
  image String?

  email String? @unique
  phone String?
  phoneCode String? // dial prefix, e.g. "+94"

  country  String?
  province String?
  district String?
  city     String?
  address  String?

  dateOfBirth DateTime?

  // Marketing preferences shown on the profile page.
  offersEmail Boolean @default(true)
  offersSms   Boolean @default(false)

  password String?

  emailVerified DateTime?
  phoneVerified Boolean   @default(false)

  provider   String?
  providerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts        Account[]
  orders          Order[]
  reviews         Review[]
  reviewResponses ReviewResponse[] @relation("ReviewResponseAuthor")
  addresses       Address[]

  status      CustomerStatus @default(ACTIVE)
  blockReason String?
  blockedAt   DateTime?

  // ── Promos ──
  targetedPromos PromoCustomer[]
  promoUsages    PromoUsage[]
  notifications  CustomerNotification[]

  // ── Push ──
  pushSubscriptions PushSubscription[]

  // ── Offers ──
  claimedOffers OfferClaim[]
}

model Account {
  id                String @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Saved delivery addresses shown on the customer profile page. The legacy
// single address columns on User are still used by checkout; this table adds
// the multi-address address book the profile UI needs.
model Address {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String
  line      String
  country   String
  province  String
  district  String
  city      String
  postal    String
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ═══════════════════════════════════════════════════════════════
// ── Orders ──
// ═══════════════════════════════════════════════════════════════

model Order {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  fullName      String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String
  paymentMethod String // "cod" | "card"

  subtotal Float
  shipping Float

  // ── Promo code applied to this order (denormalized for quick display) ──
  promoCode      String?
  discountAmount Float   @default(0)

  total Float // = subtotal + shipping - discountAmount

  status OrderStatus @default(PENDING)
  items  OrderItem[]

  // Courier tracking reference, shown on the customer profile when present.
  trackingNumber String?

  // ── Delivery ──
  driverId       Int?
  driver         Driver?        @relation("OrderDriver", fields: [driverId], references: [id], onDelete: SetNull)
  deliveryStatus DeliveryStatus @default(UNASSIGNED)
  assignedAt     DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  deliveryNote   String?

  // Latest position shared by the driver app, used by the customer tracker.
  currentLat        Float?
  currentLng        Float?
  locationUpdatedAt DateTime?

  trackingEvents TrackingEvent[]

  returnRequest ReturnRequest?
  payoutItems   PayoutItem[]
  promoUsage    PromoUsage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, deliveryStatus])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId        Int
  productVariantId Int?

  name         String
  sellingPrice Float
  quantity     Int
}

// ═══════════════════════════════════════════════════════════════
// ── Drivers / Delivery tracking ──
// ═══════════════════════════════════════════════════════════════

enum DriverStatus {
  ACTIVE
  BLOCKED
}

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

// A delivery rider. Admins create these from the admin panel; the driver app
// signs in with the auto-generated `username` + password.
model Driver {
  id Int @id @default(autoincrement())

  name     String
  username String  @unique
  email    String? @unique
  phone    String?

  password      String
  plainPassword String? // kept so an admin can re-share the generated login

  vehicleType   String?
  vehicleNumber String?
  licenseNumber String?
  note          String?

  status      DriverStatus @default(ACTIVE)
  isAvailable Boolean      @default(true)
  lastLoginAt DateTime?

  // Last known position (updated from the driver app).
  currentLat        Float?
  currentLng        Float?
  locationUpdatedAt DateTime?

  deliveries     Order[]         @relation("OrderDriver")
  trackingEvents TrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Append-only history shown on the customer tracking timeline.
model TrackingEvent {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  driverId Int?
  driver   Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  status  DeliveryStatus
  title   String
  message String?

  latitude  Float?
  longitude Float?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

// ═══════════════════════════════════════════════════════════════
// ── Reviews ──
// ═══════════════════════════════════════════════════════════════

enum ReviewStatus {
  VISIBLE
  HIDDEN
}

enum ReviewReportStatus {
  NONE
  OPEN
  RESOLVED
  DISMISSED
}

enum ReviewAuthorType {
  CUSTOMER
  VENDOR
  ADMIN
}

model Review {
  id Int @id @default(autoincrement())

  rating  Int
  comment String? @db.Text

  // Moderation: hidden reviews stay on record but are not shown in the store.
  status   ReviewStatus @default(VISIBLE)
  editedAt DateTime?

  // Vendors can report a review of one of their products; admins resolve it.
  reportStatus       ReviewReportStatus @default(NONE)
  reportReason       String?             @db.Text
  reportedAt         DateTime?
  reportResolvedAt   DateTime?
  reportedByVendorId Int?
  reportedByVendor   Vendor? @relation("ReviewReports", fields: [reportedByVendorId], references: [id], onDelete: SetNull)
  adminNote          String?             @db.Text

  // Verified purchase is informational: the customer had a delivered order
  // containing this product when the review was written.
  verifiedPurchase Boolean @default(false)

  userId Int
  user   User @relation(fields: [userId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  responses ReviewResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One review per customer per product is enforced by the API; this index
  // keeps the lookup fast without risking existing duplicate rows.
  @@index([userId, productId])
  @@index([productId, status])
  @@index([reportStatus])
}

model ReviewResponse {
  id      Int    @id @default(autoincrement())
  comment String @db.Text

  // Who wrote the reply: the customer (follow-up), the product's vendor, or an admin.
  authorType ReviewAuthorType @default(VENDOR)

  userId Int?
  user   User? @relation("ReviewResponseAuthor", fields: [userId], references: [id], onDelete: Cascade)

  vendorId Int?
  vendor   Vendor? @relation("ReviewResponseAuthor", fields: [vendorId], references: [id], onDelete: Cascade)

  adminId Int?
  admin   Admin? @relation("ReviewResponseAuthor", fields: [adminId], references: [id], onDelete: Cascade)

  reviewId Int
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor Store Settings ──
// ═══════════════════════════════════════════════════════════════

model VendorSettings {
  id Int @id @default(autoincrement())

  vendorId Int    @unique
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  storeName   String?
  storeLogo   String?
  storeBanner String?
  description String?

  taxId       String?
  businessReg String?

  bankName      String?
  accountName   String?
  accountNumber String?
  branch        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor Payouts ──
// ═══════════════════════════════════════════════════════════════

model Payout {
  id Int @id @default(autoincrement())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  amount Float
  status PayoutStatus @default(PENDING)
  period String
  paidAt DateTime?
  note   String?

  items PayoutItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PayoutStatus {
  PENDING
  PAID
  CANCELLED
}

model PayoutItem {
  id       Int    @id @default(autoincrement())
  payoutId Int
  payout   Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  amount Float
}

// ═══════════════════════════════════════════════════════════════
// ── Vendor Notifications ──
// ═══════════════════════════════════════════════════════════════

model Notification {
  id Int @id @default(autoincrement())

  vendorId Int
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  type    String
  message String
  read    Boolean @default(false)

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ── Promos ──
// ═══════════════════════════════════════════════════════════════

enum PromoDiscountType {
  PERCENTAGE
  FIXED
}

// Who the promo is aimed at:
// ALL              -> anyone can use it
// NEW_CUSTOMER     -> customers with zero prior orders (first purchase only)
// OLD_CUSTOMER     -> customers who already have at least one order
// SELECTED_CUSTOMER-> a criteria-matched list (see PromoCustomer)
enum PromoTargetType {
  ALL
  NEW_CUSTOMER
  OLD_CUSTOMER
  SELECTED_CUSTOMER
}

enum PromoStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model Promo {
  id Int @id @default(autoincrement())

  code        String  @unique
  name        String  @default("")
  description String?

  discountType   PromoDiscountType
  discountValue  Float
  maxDiscount    Float? // cap on discount amount when discountType = PERCENTAGE
  minOrderAmount Float?

  targetType PromoTargetType @default(ALL)

  // ── Criteria used ONLY when targetType = SELECTED_CUSTOMER ──
  minOrderCount Int?
  minTotalSpent Float?
  maxTotalSpent Float?

  // ── Usage limits ──
  usageLimit        Int? // overall redemption cap across all customers (null = unlimited)
  usageLimitPerUser Int  @default(1)
  usedCount         Int  @default(0)

  expiresAt DateTime?
  startsAt  DateTime?

  status PromoStatus @default(ACTIVE)

  // ── Who created it ──
  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  adminId Int?
  admin   Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  targetCustomers PromoCustomer[]
  usages          PromoUsage[]
  notifications   CustomerNotification[]
  offers          Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per customer targeted by a promo.
// Also doubles as the notification-sent tracker.
model PromoCustomer {
  id Int @id @default(autoincrement())

  promoId Int
  promo   Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  notified   Boolean   @default(false)
  notifiedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([promoId, userId])
}

// One row per actual redemption — ties a promo to the order it was used on.
model PromoUsage {
  id Int @id @default(autoincrement())

  promoId Int
  promo   Promo @relation(fields: [promoId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountAmount Float

  createdAt DateTime @default(now())
}

// ── Customer-facing notifications ──
model CustomerNotification {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // e.g. "PROMO_CODE", "ORDER_UPDATE"
  title   String
  message String
  read    Boolean @default(false)

  promoId Int?
  promo   Promo? @relation(fields: [promoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ── Return Requests ──
// ═══════════════════════════════════════════════════════════════

model ReturnRequest {
  id Int @id @default(autoincrement())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  reason       String
  status       ReturnStatus @default(PENDING)
  adminNote    String?
  refundAmount Float?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
}

// ═══════════════════════════════════════════════════════════════
// ── Shipping ──
// ═══════════════════════════════════════════════════════════════

model ShippingZone {
  id Int @id @default(autoincrement())

  name    String
  regions String

  rates ShippingRate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingRate {
  id Int @id @default(autoincrement())

  zoneId Int
  zone   ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  minWeight Float?
  maxWeight Float?
  price     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════
// ── Inventory ──
// ═══════════════════════════════════════════════════════════════

model InventoryLog {
  id Int @id @default(autoincrement())

  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  change Int
  reason String
  note   String?

  createdAt DateTime @default(now())
}

// One row per restock ("lot") of a variant. FIFO consumes the batch with the
// earliest expiry first, then the oldest received batch.
model InventoryBatch {
  id Int @id @default(autoincrement())

  productVariantId Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  quantity  Int  // quantity received
  remaining Int  // quantity still on hand, reduced by FIFO sales
  expiresAt DateTime?
  batchNumber String?
  note      String?

  createdAt DateTime @default(now())

  @@index([productVariantId, expiresAt])
}

// ═══════════════════════════════════════════════════════════════
// ── Push Notifications ──
// ═══════════════════════════════════════════════════════════════

model PushSubscription {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
}

model AdminPushSubscription {
  id Int @id @default(autoincrement())

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════
// ── Offers (landing-page deals / banners) ──
// ═══════════════════════════════════════════════════════════════

enum OfferStatus {
  ACTIVE
  INACTIVE
}

enum OfferApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum OfferBasis {
  FESTIVE
  SPECIAL_DAY
  ANNIVERSARY
  NEW_CUSTOMER
  FLASH_SALE
  END_OF_SEASON
  PAYDAY
  PAYMENT
  LOYALTY
  PRODUCT_LAUNCH
  CLEARANCE
  BUNDLE
  CATEGORY
  OTHER
}

model Offer {
  id Int @id @default(autoincrement())

  title       String
  subtitle    String?
  description String? @db.Text
  image       String? @db.LongText // base64 data URL or image URL
  images      String? @db.LongText // JSON array of gallery image data URLs

  badgeText String? // e.g. "20% OFF", "Festival Sale"
  ctaText   String  @default("Shop Now")
  ctaLink   String? // where the button goes, e.g. /products?category=3

  // optional: show this promo code on the offer card
  promoId Int?
  promo   Promo? @relation(fields: [promoId], references: [id], onDelete: SetNull)

  // The vendor that submitted the offer. Null for offers created by an admin.
  vendorId Int?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  basis         OfferBasis?
  subCategoryId Int?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)

  approvalStatus OfferApprovalStatus @default(APPROVED)
  reviewNote     String?

  products OfferProduct[]
  claims   OfferClaim[]

  sortOrder     Int     @default(0) // lower = shown first
  showOnLanding Boolean @default(true) // false = only on the /offer page

  startsAt DateTime?
  endsAt   DateTime?

  status OfferStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfferProduct {
  id Int @id @default(autoincrement())

  offerId Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([offerId, productId])
}

// A customer claiming an offer (deals/banner). One claim per customer
// per offer — the unique index makes the claim endpoint idempotent.
model OfferClaim {
  id Int @id @default(autoincrement())

  offerId Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([offerId, userId])
}
